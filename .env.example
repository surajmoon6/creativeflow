# Copy to .env and fill in. Never commit .env.

# Long random string. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty locally: one is generated into backend/.secret_key on first run.
SECRET_KEY=

# Local: SQLite file (the default). On the server, Postgres, for example:
# DATABASE_URL=postgresql+psycopg://creativeflow:PASSWORD@localhost:5432/creativeflow
DATABASE_URL=

# Where private files (design uploads, previews, finals) live. Default: ./storage/private
STORAGE_DIR=

# The address clients open. Used in review links and WhatsApp messages.
#   ./dev.sh (Vite):   http://localhost:5173
#   ./start.sh:        http://localhost:5001
#   Server:            https://review.yourstudio.in
PUBLIC_URL=http://localhost:5173

# Max upload size in MB
MAX_UPLOAD_MB=100

# Set to 1 once the site is served over HTTPS
SESSION_COOKIE_SECURE=0

# Optional email. Without SMTP_HOST, emails are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Server (docker compose) ---
# Your domain, pointed at the server's IP. Caddy gets the HTTPS certificate for it automatically.
# DOMAIN=review.yourstudio.in
# Set to 1 when the app runs behind a reverse proxy (docker compose does this for you).
# TRUST_PROXY=1
